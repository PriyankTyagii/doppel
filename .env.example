# Backend config. Copy to .env (git-ignored); the Makefile loads it.

# Groq for root-cause explanations and judge mode. Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Firebase Authentication: the project id from the Firebase console.
FIREBASE_PROJECT_ID=
# Verified emails allowed to use break-it-live (comma-separated).
DOPPEL_ADMIN_EMAILS=
# Dashboard origins allowed to call the APIs.
DOPPEL_ALLOWED_ORIGINS=http://localhost:5180
